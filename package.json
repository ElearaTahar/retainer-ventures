{
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^7.18.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "generate:ventures": "tsc -p tsconfig.scripts.json && node .generated-scripts/generate-ventures.js",
    "generate:items": "tsc -p tsconfig.scripts.json && node .generated-scripts/generate-items.js",
    "generate:rewards": "tsc -p tsconfig.scripts.json && node .generated-scripts/generate-venture-rewards.js",
    "generate:reward-supplement": "tsc -p tsconfig.scripts.json && node .generated-scripts/generate-exploration-reward-supplement.js",
    "check:missing-rewards": "tsc -p tsconfig.scripts.json && node .generated-scripts/check-missing-exploration-rewards.js",
    "generate:data": "npm run generate:ventures && npm run generate:items && npm run generate:reward-supplement && npm run generate:rewards && npm run check:missing-rewards"
  }
}
